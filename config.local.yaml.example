# 复制为 config.local.yaml（已被 .gitignore 忽略）后按需修改，
# 不要改动 config.yaml 里的公共默认值。

paths:
  nuclei_binary: "C:/Users/you/bin/nuclei.exe"
  httpx_binary: "C:/Users/you/bin/httpx.exe"
  templates_dir: "C:/Users/you/nuclei-templates"

network:
  proxy: ""            # 例如 "http://127.0.0.1:7897"，留空关闭

llm:
  provider: "auto"     # auto | ollama | openai
  base_url: "https://api.deepseek.com/v1"
  model: "deepseek-chat"
  # API Key 优先用环境变量 NUCLEIAI_LLM_API_KEY

server:
  host: "127.0.0.1"
  port: 8080
  auth_token: ""       # 设置后面板需要登录，或用环境变量 NUCLEIAI_AUTH_TOKEN
